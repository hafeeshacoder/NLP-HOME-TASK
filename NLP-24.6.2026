from collections import Counter
import nltk
import string
import matplotlib.pyplot as plt
from nltk.corpus import stopwords
from nltk.tokenize import word_tokenize

text = input()

# 1. Convert to lowercase
text = text.lower()

# 2. Remove punctuation
for p in string.punctuation:
    text = text.replace(p, "")

# 3. Tokenize text
words = word_tokenize(text)
print("Tokens:", words)

# Remove stopwords
stop_words = set(stopwords.words("english"))
filtered_words = [w for w in words if w not in stop_words]
print("Filtered Words:", filtered_words)

# 4. Word frequency distribution
freq = Counter(filtered_words)
print("Word Frequency:", freq)

# 5. Vocabulary (unique words)
vocabulary = set(filtered_words)
print("Vocabulary:", vocabulary)

# 6. Top 5 most frequent words
print("\nTop 5 Words:")
for word, count in freq.most_common(5):
    print(word, ":", count)

# 7. Type-Token Ratio (TTR)
ttr = len(vocabulary) / len(filtered_words)
print("\nType-Token Ratio (TTR):", round(ttr, 2))

# 8. Dominant topic based on frequency
dominant_topic = freq.most_common(1)[0][0]
print("Dominant Topic:", dominant_topic)

# 9. Bar chart visualization
plt.figure(figsize=(8,5))
plt.bar(freq.keys(), freq.values())
plt.title("Word Frequency Distribution")
plt.xlabel("Words")
plt.ylabel("Frequency")
plt.xticks(rotation=45)
plt.show()
