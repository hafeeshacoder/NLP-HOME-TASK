# 1. CONFIGURATION
# ============================================================

DATASET_PATH = "English-Tamil-Parallel-Corpus.csv"

BATCH_SIZE = 32
EMBEDDING_DIM = 256
HIDDEN_DIM = 512
NUM_LAYERS = 1

LEARNING_RATE = 0.001
EPOCHS = 10

MAX_LENGTH = 50

DEVICE = torch.device(
    "cuda" if torch.cuda.is_available() else "cpu"
)

print("Using Device:", DEVICE)


# ============================================================
# 2. LOAD DATASET
# ============================================================

df = pd.read_csv(DATASET_PATH)

print("\nDataset Shape:")
