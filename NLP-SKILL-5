import pandas as pd
import numpy as np
from collections import defaultdict, Counter

# ============================================================
# 1. LOAD DATASET
# ============================================================

df = pd.read_csv("english_ewt_ud_hmm_sentences.csv")

print("Dataset loaded successfully!")
print(df.head())


# ============================================================
# 2. PREPARE SENTENCES
# ============================================================

sentences = []

for _, row in df.iterrows():
    words = row["words"].split()
    tags = row["pos_tags"].split()
    sentences.append((words, tags))

print("\nNumber of sentences:", len(sentences))


# ============================================================
# 3. FIND ALL POS TAGS
# ============================================================

tags = set()

for words, pos_tags in sentences:
    tags.update(pos_tags)

tags = sorted(tags)

print("\nPOS Tags:")
print(tags)


# ============================================================
# 4. INITIAL PROBABILITIES
# P(tag) = Number of sentences starting with tag /
#          Total number of sentences
# ============================================================

initial_counts = Counter()

for words, pos_tags in sentences:
    initial_counts[pos_tags[0]] += 1

total_sentences = len(sentences)

initial_prob = {}

for tag in tags:
    initial_prob[tag] = initial_counts[tag] / total_sentences

print("\nInitial Probabilities:")
for tag, prob in initial_prob.items():
    print(tag, ":", round(prob, 4))


# ============================================================
# 5. TRANSITION PROBABILITIES
# P(tag2 | tag1)
# ============================================================

transition_counts = defaultdict(Counter)

for words, pos_tags in sentences:

    for i in range(len(pos_tags) - 1):

        current_tag = pos_tags[i]
        next_tag = pos_tags[i + 1]

        transition_counts[current_tag][next_tag] += 1


transition_prob = defaultdict(dict)

for current_tag in tags:

    total = sum(transition_counts[current_tag].values())

    for next_tag in tags:

        if total > 0:
            transition_prob[current_tag][next_tag] = (
                transition_counts[current_tag][next_tag] / total
            )
        else:
            transition_prob[current_tag][next_tag] = 0


print("\nTransition Probabilities:")

for current_tag in tags:

    for next_tag in tags:

        probability = transition_prob[current_tag][next_tag]

        if probability > 0:
            print(
                current_tag,
                "->",
                next_tag,
                ":",
                round(probability, 4)
            )


# ============================================================
# 6. EMISSION PROBABILITIES
# P(word | tag)
# ============================================================

emission_counts = defaultdict(Counter)

for words, pos_tags in sentences:

    for word, tag in zip(words, pos_tags):

        emission_counts[tag][word] += 1


emission_prob = defaultdict(dict)

for tag in tags:

    total = sum(emission_counts[tag].values())

    for word in emission_counts[tag]:

        emission_prob[tag][word] = (
            emission_counts[tag][word] / total
        )


print("\nSample Emission Probabilities:")

for tag in tags:

    print("\n", tag)

    count = 0

    for word, probability in emission_prob[tag].items():

        print(
            word,
            ":",
            round(probability, 4)
        )

        count += 1

        if count == 5:
            break


# ============================================================
# 7. VITERBI ALGORITHM
# ============================================================

def viterbi(words):

    # Dynamic programming table
    V = [{}]

    # Backpointer
    backpointer = [{}]

    # --------------------------------------------------------
    # First word
    # --------------------------------------------------------

    for tag in tags:

        emission = emission_prob[tag].get(words[0], 1e-6)

        initial = initial_prob.get(tag, 1e-6)

        V[0][tag] = np.log(initial) + np.log(emission)

        backpointer[0][tag] = None


    # --------------------------------------------------------
    # Remaining words
    # --------------------------------------------------------

    for i in range(1, len(words)):

        V.append({})
        backpointer.append({})

        for current_tag in tags:

            emission = emission_prob[current_tag].get(
                words[i],
                1e-6
            )

            best_probability = -np.inf
            best_previous_tag = None

            for previous_tag in tags:

                transition = transition_prob[
                    previous_tag
                ].get(
                    current_tag,
                    1e-6
                )

                probability = (
                    V[i - 1][previous_tag]
                    + np.log(transition)
                    + np.log(emission)
                )

                if probability > best_probability:

                    best_probability = probability
                    best_previous_tag = previous_tag

            V[i][current_tag] = best_probability
            backpointer[i][current_tag] = best_previous_tag


    # --------------------------------------------------------
    # Find best final tag
    # --------------------------------------------------------

    best_final_tag = max(
        V[-1],
        key=V[-1].get
    )

    best_path = [best_final_tag]


    # --------------------------------------------------------
    # Backtracking
    # --------------------------------------------------------

    for i in range(
        len(words) - 1,
        0,
        -1
    ):

        best_final_tag = backpointer[i][best_final_tag]

        best_path.append(best_final_tag)


    best_path.reverse()

    return best_path


# ============================================================
# 8. TEST THE POS TAGGER
# ============================================================

test_sentence = "The small bird flew away ."

test_words = test_sentence.split()

predicted_tags = viterbi(test_words)


# ============================================================
# 9. DISPLAY RESULT
# ============================================================

print("\n========================================")
print("HMM POS TAGGING RESULT")
print("========================================")

for word, tag in zip(
    test_words,
    predicted_tags
):

    print(
        f"{word:15} -> {tag}"
    )
